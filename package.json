<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lexis Intelligence — Legal Document Analyzer</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1a2e; --ink2: #2d2d4a; --gold: #c9a84c; --gold-light: #f0dfa0;
    --cream: #faf8f3; --parchment: #f2ede0; --border: #ddd8c8; --muted: #8a8070;
    --red: #b04040; --red-bg: #fdf0f0; --green: #2d6a4f; --green-bg: #f0f7f4;
    --amber: #92600a; --amber-bg: #fdf6e3;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--cream); font-family: 'IBM Plex Sans', sans-serif; color: var(--ink); min-height: 100vh; }

  /* HEADER */
  .header {
    background: var(--ink); padding: 0 32px; height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 2px solid var(--gold); position: sticky; top: 0; z-index: 100;
  }
  .header-left { display: flex; align-items: center; gap: 14px; }
  .logo-mark { width: 38px; height: 38px; border: 1.5px solid var(--gold); display: flex; align-items: center; justify-content: center; font-size: 20px; }
  .logo-text { font-family: 'Playfair Display', serif; font-size: 20px; color: #fff; }
  .logo-sub { font-family: 'IBM Plex Mono', monospace; font-size: 9px; color: var(--gold); letter-spacing: 0.14em; text-transform: uppercase; margin-top: 2px; }
  .status-pill { font-family: 'IBM Plex Mono', monospace; font-size: 10px; padding: 4px 12px; border: 1px solid rgba(201,168,76,0.4); color: var(--gold); letter-spacing: 0.08em; }

  /* LAYOUT */
  .layout { display: grid; grid-template-columns: 300px 1fr; min-height: calc(100vh - 64px); }

  /* SIDEBAR */
  .sidebar { background: var(--parchment); border-right: 1px solid var(--border); padding: 24px 18px; display: flex; flex-direction: column; gap: 22px; }
  .section-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }

  /* Drop zone */
  .drop-zone { border: 1.5px dashed var(--border); background: var(--cream); padding: 22px 14px; text-align: center; cursor: pointer; transition: all 0.2s; user-select: none; }
  .drop-zone:hover, .drop-zone.drag { border-color: var(--gold); background: #fdf9f0; }
  .drop-zone.loaded { border-style: solid; border-color: var(--green); background: var(--green-bg); }
  .drop-icon { font-size: 28px; margin-bottom: 8px; }
  .drop-main { font-size: 14px; font-weight: 500; color: var(--ink); margin-bottom: 3px; }
  .drop-sub { font-size: 12px; color: var(--muted); }
  .drop-filename { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--green); margin-top: 8px; word-break: break-all; display: none; }
  .drop-zone.loaded .drop-filename { display: block; }

  /* Mode buttons */
  .mode-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .mode-btn { padding: 10px 8px; border: 1px solid var(--border); background: var(--cream); cursor: pointer; text-align: left; transition: all 0.15s; font-family: 'IBM Plex Sans', sans-serif; width: 100%; }
  .mode-btn:hover { border-color: var(--gold); background: #fdf9f0; }
  .mode-btn.active { border-color: var(--ink); background: var(--ink); color: #fff; }
  .mode-btn.active .mi { color: var(--gold); }
  .mi { font-size: 15px; display: block; margin-bottom: 4px; }
  .ml { font-size: 11px; font-weight: 500; line-height: 1.3; display: block; }

  /* Custom */
  .custom-box { display: none; }
  .custom-box.on { display: block; }
  .custom-ta { width: 100%; border: 1px solid var(--border); background: var(--cream); padding: 10px 12px; font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; color: var(--ink); resize: vertical; min-height: 80px; outline: none; }
  .custom-ta:focus { border-color: var(--gold); }

  /* Run button */
  .run-btn { width: 100%; padding: 15px; background: var(--gold); color: var(--ink); border: none; font-family: 'Playfair Display', serif; font-size: 15px; font-weight: 600; letter-spacing: 0.04em; cursor: pointer; transition: all 0.2s; }
  .run-btn:hover:not(:disabled) { background: #b8943e; }
  .run-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .disclaimer { font-family: 'IBM Plex Mono', monospace; font-size: 9px; color: var(--muted); line-height: 1.6; border-top: 1px solid var(--border); padding-top: 14px; }

  /* MAIN */
  .main { padding: 36px; overflow-y: auto; }

  .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 420px; text-align: center; opacity: 0.35; }
  .empty-glyph { font-family: 'Playfair Display', serif; font-size: 80px; color: var(--border); line-height: 1; margin-bottom: 16px; }
  .empty-label { font-size: 15px; color: var(--muted); line-height: 1.8; }

  .loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 420px; gap: 18px; }
  .loading-mode { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted); letter-spacing: 0.12em; text-transform: uppercase; }
  .loading-bar { width: 220px; height: 2px; background: var(--border); overflow: hidden; }
  .loading-fill { height: 100%; background: var(--gold); animation: sweep 1.5s ease-in-out infinite; }
  @keyframes sweep { 0%{width:0;margin-left:0} 50%{width:100%;margin-left:0} 100%{width:0;margin-left:100%} }
  .loading-sub { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted); }

  .result-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .result-title { font-family: 'Playfair Display', serif; font-size: 26px; color: var(--ink); }
  .result-file { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted); margin-top: 4px; }
  .result-meta { font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: var(--muted); text-align: right; line-height: 1.8; }
  .result-body { font-size: 15px; line-height: 1.85; color: var(--ink); white-space: pre-wrap; }

  .copy-btn { margin-top: 24px; padding: 7px 16px; border: 1px solid var(--border); background: transparent; font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted); cursor: pointer; transition: all 0.2s; }
  .copy-btn:hover { border-color: var(--ink); color: var(--ink); }

  .error-box { background: var(--red-bg); border: 1px solid #e8c0c0; padding: 20px 24px; color: var(--red); font-size: 14px; line-height: 1.7; margin-top: 20px; }
  .error-box strong { display: block; font-size: 16px; margin-bottom: 8px; }

  input[type="file"] { display: none; }
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
</style>
</head>
<body>

<div class="header">
  <div class="header-left">
    <div class="logo-mark">⚖</div>
    <div>
      <div class="logo-text">Lexis Intelligence</div>
      <div class="logo-sub">Legal Document Analyzer</div>
    </div>
  </div>
  <div class="status-pill" id="statusPill">● READY</div>
</div>

<div class="layout">
  <div class="sidebar">

    <div>
      <div class="section-label">1 — Document</div>
      <div class="drop-zone" id="dropZone"
           onclick="document.getElementById('fileInput').click()"
           ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDrop(event)">
        <div class="drop-icon" id="dropIcon">📄</div>
        <div class="drop-main" id="dropMain">Click to upload</div>
        <div class="drop-sub" id="dropSub">PDF, TXT, MD, or CSV</div>
        <div class="drop-filename" id="dropFilename"></div>
      </div>
      <input type="file" id="fileInput" accept=".pdf,.txt,.md,.csv" onchange="handleFile(this.files[0])">
    </div>

    <div>
      <div class="section-label">2 — Analysis Mode</div>
      <div class="mode-grid">
        <button class="mode-btn active" data-mode="summary" onclick="pickMode(this)"><span class="mi">📋</span><span class="ml">Plain Summary</span></button>
        <button class="mode-btn" data-mode="risks" onclick="pickMode(this)"><span class="mi">🚨</span><span class="ml">Risks & Red Flags</span></button>
        <button class="mode-btn" data-mode="dates" onclick="pickMode(this)"><span class="mi">📅</span><span class="ml">Dates & Deadlines</span></button>
        <button class="mode-btn" data-mode="clauses" onclick="pickMode(this)"><span class="mi">🔍</span><span class="ml">Clause Analysis</span></button>
        <button class="mode-btn" data-mode="definitions" onclick="pickMode(this)"><span class="mi">📖</span><span class="ml">Definitions & Refs</span></button>
        <button class="mode-btn" data-mode="compliance" onclick="pickMode(this)"><span class="mi">✅</span><span class="ml">Compliance Check</span></button>
        <button class="mode-btn" data-mode="obligations" onclick="pickMode(this)"><span class="mi">⚡</span><span class="ml">Rights & Obligations</span></button>
        <button class="mode-btn" data-mode="custom" onclick="pickMode(this)"><span class="mi">💬</span><span class="ml">Ask Anything</span></button>
      </div>
    </div>

    <div class="custom-box" id="customBox">
      <div class="section-label">Your Question</div>
      <textarea class="custom-ta" id="customQ" placeholder="e.g. What are the termination conditions? Is there a non-compete clause? Who bears liability?"></textarea>
    </div>

    <button class="run-btn" id="runBtn" onclick="analyze()">Analyze Document →</button>

    <div class="disclaimer">
      ⚠ For informational purposes only.<br>
      Not a substitute for qualified legal counsel.<br><br>
      Documents are sent securely to Anthropic's API and are not stored.
    </div>

  </div>

  <div class="main" id="mainPanel">
    <div class="empty-state">
      <div class="empty-glyph">§</div>
      <div class="empty-label">Upload a legal document<br>Choose an analysis mode<br>Click Analyze Document</div>
    </div>
  </div>
</div>

<script>
  let fileB64 = null, fileMime = 'text/plain', fileName = '', mode = 'summary';
  let lastResult = '';

  const PROMPTS = {
    summary: `You are a senior legal analyst. Summarize this legal document in plain language a non-lawyer can understand.\n\nCover:\n1. DOCUMENT TYPE — What kind of document is this?\n2. PARTIES — Who are the parties and what are their roles?\n3. CORE PURPOSE — What does this document do in plain terms?\n4. KEY TERMS — The 6 most important terms or conditions\n5. OBLIGATIONS — What must each party do?\n6. VERDICT — Is this document standard, favorable, or concerning? Why?`,
    risks: `You are a legal risk analyst. Identify every risk and red flag in this document.\n\nFor each risk:\n[SEVERITY: HIGH / MEDIUM / LOW]\nRisk title\nClause reference\nPlain-language explanation\nWhy it matters\nQuestion to ask a lawyer\n\nOrder from most to least severe. End with a RISK SUMMARY: overall risk level and top recommendation.`,
    dates: `You are a legal deadline specialist. Extract every date, deadline, and timeframe.\n\nFor each:\nDATE/TIMEFRAME: [exact date or period]\nACTION REQUIRED: [what must happen]\nRESPONSIBLE PARTY: [who]\nCONSEQUENCE IF MISSED: [what happens]\nPRIORITY: [Critical / Important / Advisory]\n\nAlso flag: MISSING DATES and identify the 3 most critical deadlines.`,
    clauses: `You are a contract law expert. Analyze this document clause by clause.\n\nFor each clause:\nCLAUSE NAME\nPlain-language explanation\nClassification: Standard / Favorable / Unfavorable / Unusual\nConcerns or red flags\nIndustry standard comparison\n\nEnd with a CLAUSE SCORECARD showing counts of each classification.`,
    definitions: `You are a legal language specialist.\n\n1. DEFINED TERMS — Every defined/capitalized term and its meaning\n2. UNDEFINED IMPORTANT TERMS — Terms used but not defined\n3. AMBIGUOUS LANGUAGE — Phrases open to multiple interpretations and the risks created\n4. CROSS-REFERENCES — How clauses reference each other, any conflicts\n5. INCONSISTENCIES — Terms used differently in different places\n6. RECOMMENDATIONS — What should be added, clarified, or amended`,
    compliance: `You are a regulatory compliance expert.\n\n1. APPLICABLE LAW — What laws and regulations govern this document?\n2. COMPLIANCE GAPS — Missing required clauses or disclosures\n3. REGULATORY RED FLAGS — Provisions that may conflict with regulations\n4. JURISDICTION — Governing law clause analysis\n5. DATA PRIVACY — Any GDPR, data handling, or consent issues\n6. RECOMMENDATIONS — Prioritized list of changes needed`,
    obligations: `You are a legal obligations analyst. For EACH PARTY:\n\nPARTY NAME:\nOBLIGATIONS (must do): [obligation — due when — consequence if breached]\nRIGHTS (entitled to): [right — conditions — duration]\nRESTRICTIONS (cannot do): [restriction — scope — duration]\n\nThen provide:\nMUTUAL OBLIGATIONS\nCONDITIONAL OBLIGATIONS\nIMBALANCES — anything one-sided or disproportionate\nENFORCEMENT — remedies specified for breach`,
    custom: null
  };

  const LABELS = {
    summary:'Plain Language Summary', risks:'Risk & Red Flag Analysis',
    dates:'Key Dates & Deadlines', clauses:'Clause-Level Analysis',
    definitions:'Definitions & Cross-References', compliance:'Compliance Review',
    obligations:'Rights & Obligations Map', custom:'Custom Analysis'
  };

  function onDragOver(e) { e.preventDefault(); document.getElementById('dropZone').classList.add('drag'); }
  function onDragLeave() { document.getElementById('dropZone').classList.remove('drag'); }
  function onDrop(e) { e.preventDefault(); onDragLeave(); if (e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]); }

  function handleFile(file) {
    if (!file) return;
    fileName = file.name;
    fileMime = (file.type === 'application/pdf' || file.name.endsWith('.pdf')) ? 'application/pdf' : 'text/plain';
    const r = new FileReader();
    r.onload = e => {
      fileB64 = e.target.result.split(',')[1];
      const dz = document.getElementById('dropZone');
      dz.classList.add('loaded');
      document.getElementById('dropIcon').textContent = '✓';
      document.getElementById('dropMain').textContent = 'Document loaded';
      document.getElementById('dropSub').textContent = 'Ready to analyze';
      document.getElementById('dropFilename').textContent = file.name;
    };
    r.readAsDataURL(file);
  }

  function pickMode(btn) {
    document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    mode = btn.dataset.mode;
    document.getElementById('customBox').classList.toggle('on', mode === 'custom');
  }

  async function analyze() {
    if (!fileB64) { showError('No Document', 'Please upload a document first.'); return; }
    const prompt = mode === 'custom' ? document.getElementById('customQ').value.trim() : PROMPTS[mode];
    if (!prompt) { showError('No Question', 'Please type your question.'); return; }

    const btn = document.getElementById('runBtn');
    btn.disabled = true; btn.textContent = 'Analyzing…';
    document.getElementById('statusPill').textContent = '● ANALYZING';
    showLoading();

    const t0 = Date.now();
    try {
      // Calls YOUR server, not Anthropic directly — that's the fix
      const res = await fetch('/api/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'claude-sonnet-4-20250514',
          max_tokens: 2000,
          system: 'You are Lexis, an expert legal document analyst with 20+ years of experience across contracts, NDAs, employment law, real estate, compliance, regulations, and judicial decisions. Be thorough, precise, and always explain legal language in plain terms.',
          messages: [{
            role: 'user',
            content: [
              { type: 'document', source: { type: 'base64', media_type: fileMime, data: fileB64 } },
              { type: 'text', text: prompt }
            ]
          }]
        })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data?.error?.message || `Error ${res.status}`);
      const text = (data.content || []).filter(b => b.type === 'text').map(b => b.text).join('\n');
      if (!text) throw new Error('Empty response. Please try again.');

      lastResult = text;
      const elapsed = ((Date.now() - t0) / 1000).toFixed(1);
      const tokens = ((data.usage?.input_tokens || 0) + (data.usage?.output_tokens || 0)).toLocaleString();
      showResult(text, elapsed, tokens);
      document.getElementById('statusPill').textContent = '● READY';

    } catch (err) {
      showError('Analysis Failed', err.message);
      document.getElementById('statusPill').textContent = '● ERROR';
    } finally {
      btn.disabled = false; btn.textContent = 'Analyze Document →';
    }
  }

  function showLoading() {
    document.getElementById('mainPanel').innerHTML = `
      <div class="loading-state">
        <div class="loading-mode">${LABELS[mode]}</div>
        <div class="loading-bar"><div class="loading-fill"></div></div>
        <div class="loading-sub">Reading your document… 15–30 seconds</div>
      </div>`;
  }

  function showResult(text, elapsed, tokens) {
    document.getElementById('mainPanel').innerHTML = `
      <div class="result-header">
        <div>
          <div class="result-title">${LABELS[mode]}</div>
          <div class="result-file">${esc(fileName)}</div>
        </div>
        <div class="result-meta">${elapsed}s · ${tokens} tokens<br>claude-sonnet-4</div>
      </div>
      <div class="result-body">${esc(text)}</div>
      <button class="copy-btn" onclick="copyResult()">Copy to clipboard</button>`;
  }

  function showError(title, msg) {
    document.getElementById('mainPanel').innerHTML = `
      <div class="empty-state" style="opacity:0.3; min-height:200px">
        <div class="empty-glyph">§</div>
      </div>
      <div class="error-box"><strong>⚠ ${esc(title)}</strong>${esc(msg)}</div>`;
  }

  function copyResult() {
    navigator.clipboard.writeText(lastResult).then(() => {
      const b = document.querySelector('.copy-btn');
      if (b) { b.textContent = '✓ Copied!'; setTimeout(() => b.textContent = 'Copy to clipboard', 2000); }
    });
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
</script>
</body>
</html>
